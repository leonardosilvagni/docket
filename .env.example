# setup.sh copies this to .env and fills in the secret and notes folder for you.
# By hand: cp .env.example .env && chmod 600 .env
# Never commit .env: it holds your tokens and secret.

# --- Vikunja
# Address of the board. Add "127.0.0.1 <this name>" to your hosts file,
# or keep docket.localhost, which works without a hosts entry.
VIKUNJA_HOST=docket.localhost
# Long random string that signs Vikunja logins. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VIKUNJA_JWTSECRET=
# Vikunja API token: Settings > API Tokens (read/create/update on tasks; no delete needed)
VIKUNJA_TOKEN=

# --- Meeting notes
# Folder where OpenWhispr saves meeting notes (OpenWhispr > Notes > disk mirroring)
# Windows: use forward slashes, e.g. C:/Users/you/Documents/meeting-notes
NOTES_DIR=/home/you/Documents/meeting-notes
# Who the notes belong to, so the model knows whose tasks they are
OWNER=Alex, a graduate student

# --- Model (LM Studio)
# Windows (Docker Desktop): http://host.docker.internal:1234/v1
LLM_URL=http://127.0.0.1:1234/v1
# Model name exactly as `lms ls` shows it
LLM_MODEL=qwen/qwen3.5-9b
# Context length the helper loads the model with (LM Studio's default is often only 8192)
LLM_CONTEXT=32768
# LM Studio API token, only if its server has 'Require API token' turned on
LLM_API_KEY=
# auto = reason up to LLM_THINK_BUDGET tokens, then finish from that reasoning without reasoning further
# 1 = unlimited reasoning (slow), 0 = no reasoning (fastest)
LLM_THINKING=auto
LLM_THINK_BUDGET=2500

# --- Helper
# How often to check the notes folder, in seconds
POLL_SECONDS=60
# 1 = also turn notes already in the folder into tickets on first start
PROCESS_EXISTING=0
# Attempts per note before giving up (edit or touch the note to retry)
MAX_TRIES=2

# --- Calendar (optional: due dates in your phone's calendar; set up with `bash calendar/setup-calendar.sh`)
# That script fills these in for you. Leave them out if you don't use the calendar.
# RADICALE_USER=docket
# RADICALE_PASSWORD=<generated>
# Your timezone, so due times show correctly (e.g. America/New_York)
# CALENDAR_TZ=UTC
# How often to refresh the calendar, in seconds
# CALENDAR_SYNC_SECONDS=300
# Projects left out of the calendar (comma separated)
# CALENDAR_SKIP_PROJECTS=Inbox
# Due times (your timezone) that mean "just a date", shown as all-day events
# CALENDAR_ALLDAY_TIMES=00:00,12:00,13:00
# Length of an event for a task due at a specific time, in minutes
# CALENDAR_EVENT_MINUTES=30
# Optional separate, read-only Vikunja API token for the calendar (default: VIKUNJA_TOKEN)
# CALENDAR_VIKUNJA_TOKEN=
